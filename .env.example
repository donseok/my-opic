# Gemini API Key (Google AI Studio에서 발급)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Gemini 모델 (기본값: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# 서버 포트 (기본값: 3000)
PORT=3000

# CORS 허용 도메인 (쉼표 구분, 기본값: * 전체 허용)
# 프로덕션 예시: ALLOWED_ORIGINS=http://localhost:3000,http://192.168.0.10:3000
# ALLOWED_ORIGINS=*
